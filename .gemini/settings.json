{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "npx --yes @veedstudio/openedit-cli session-start gemini",
            "name": "Open Edit preflight",
            "timeout": 120000
          }
        ]
      }
    ]
  }
}
