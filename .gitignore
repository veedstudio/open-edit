node_modules/
dist/
.env
*.tsbuildinfo
.DS_Store

# Per-run outputs (regenerable)
runs/
out/
render-output/
tmp/

# LEGACY pre-CLI state files — the CLI keeps these in the app-data dir now; kept ignored so
# a lingering old file on a dev machine can never be committed
veed/.veed-token.json
veed/.veed-client.json
# The workspace the user chose to have billed (local state, names an account resource)
veed/.veed-workspace.json
# Speaking rates measured on THIS machine's paid runs. Local evidence, not shared state: the rates worth
# committing are seeded beside the CLI's voice-rates module.
veed/.veed-voice-rates.json

# Harness installs skills per-checkout; track ONLY the product skill so a stray skill can't be
# committed (and then mirrored). The already-tracked SKILL.md stays tracked regardless.
.claude/skills/*
!.claude/skills/open-edit/
!.claude/skills/open-edit/**

# Harness local state
.claude/worktrees
.claude/settings.local.json

# Internal build docs / working files (not published)
DESIGN.md
plans/

# transcription provider choice (owner-only, never committed)
.open-edit-prefs.json

# Python bytecode from the generators
__pycache__/

internal/packaging/out/
