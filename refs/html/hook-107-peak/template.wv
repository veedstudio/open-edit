<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=720, height=1280">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,800;0,900&family=Playfair+Display:ital,wght@0,500;0,600;1,500;1,600&display=swap" rel="stylesheet">
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body { width: 720px; height: 1280px; overflow: hidden; }
  #stage {
    position: relative;
    width: 720px;
    height: 1280px;
    background: #0f7a58;
    font-kerning: none;
  }
  #bg {
    position: absolute;
    inset: 0;
    width: 720px;
    height: 1280px;
    object-fit: cover;
    display: block;
  }
  .t {
    position: absolute;
    color: #fff;
    white-space: nowrap;
    width: max-content;
    line-height: 1.3;
  }
  .sans { font-family: "Archivo", "Helvetica Neue", Arial, sans-serif; font-weight: 800; letter-spacing: -0.02em; }
  .serif { font-family: "Playfair Display", Georgia, serif; font-style: italic; font-weight: 500; }

  #this { left: 60px; top: 266px; font-size: 158px; }
  #is   { left: 165px; top: 420px; font-size: 70px; }
  #called { left: 372px; top: 487px; font-size: 88px; }
  /* torn-paper red sticker, rebuilt in CSS: jagged clip-path + serif word on top */
  #sticker {
    position: absolute; left: 188px; top: 578px; width: 360px; height: 140px;
    display: flex; align-items: center; justify-content: center;
    transform: rotate(-3deg);
  }
  #sticker .paper {
    position: absolute; inset: 0;
    background: linear-gradient(135deg, #ff2a1c 0%, #e2140c 55%, #c20f08 100%);
    clip-path: polygon(
      2% 22%, 9% 8%, 18% 16%, 27% 4%, 38% 14%, 49% 2%, 60% 12%,
      72% 3%, 83% 14%, 93% 6%, 99% 24%, 96% 42%, 100% 60%, 95% 78%,
      99% 92%, 88% 86%, 77% 97%, 65% 88%, 53% 98%, 42% 87%,
      30% 96%, 19% 85%, 8% 94%, 1% 74%, 4% 56%, 0% 40%
    );
  }
  #sticker .word {
    position: relative; z-index: 2;
    font-family: "Playfair Display", Georgia, serif;
    font-style: normal; font-weight: 500;
    font-size: 56px; color: #0a0a0a; letter-spacing: 0.5px; white-space: nowrap;
  }
  #a    { left: 376px; top: 806px; font-size: 84px; }
  #match { left: 116px; top: 928px; font-size: 90px; }
  #cut  { left: 388px; top: 978px; font-size: 90px; }

  /* lead-in words fade+rise in reading order, building to the hero "intentional" */
  .t { opacity: 0; animation: wIn .42s cubic-bezier(.2,.7,.3,1) both; }
  @keyframes wIn { 0%{opacity:0;transform:translateY(0.28em)} 100%{opacity:1;transform:translateY(0)} }

  /* hero word scales in, NO opacity (stays fully opaque); container keeps its rotate(-3deg) */
  #sticker .paper { transform: scale(0); transform-origin: 50% 50%; animation: pop .5s cubic-bezier(.2,.8,.25,1) both; animation-delay: 450ms; }
  #sticker .word  { transform: scale(0); transform-origin: 50% 50%; animation: pop .5s cubic-bezier(.2,.8,.25,1) both; animation-delay: 450ms; }
  @keyframes pop { 0%{transform:scale(0)} 100%{transform:scale(1)} }
</style>
</head>
<body>
<div id="stage">
  <div class="t sans" id="this" data-node-id="this" data-node-role="text" style="animation-delay:0ms">This</div>
  <div class="t sans" id="is" data-node-id="is" data-node-role="text" style="animation-delay:150ms">is</div>
  <div class="t serif" id="called" data-node-id="called" data-node-role="text" style="animation-delay:300ms">called</div>
  <div id="sticker" data-node-id="sticker" data-node-role="text">
    <span class="paper"></span>
    <span class="word">intentional</span>
  </div>
  <div class="t serif" id="a" data-node-id="a" data-node-role="text" style="animation-delay:1050ms">a</div>
  <div class="t serif" id="match" data-node-id="match" data-node-role="text" style="animation-delay:1200ms">match-</div>
  <div class="t sans" id="cut" data-node-id="cut" data-node-role="text" style="animation-delay:1350ms">cut</div>
</div>
</body>
</html>
