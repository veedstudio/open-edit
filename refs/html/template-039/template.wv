<meta charset="utf-8">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@1,900&display=swap" rel="stylesheet">
<style>
  * { margin:0; padding:0; box-sizing:border-box; }
  body { width:736px; height:1312px; position:relative; overflow:hidden; }
  .vid { position:absolute; inset:0; width:736px; height:1312px; object-fit:cover; z-index:0; }
  @keyframes cueWin { 0%,99.99%{opacity:1} 100%{opacity:0} }
  .cue { position:absolute; inset:0; opacity:0; animation:cueWin linear forwards; }
  .pg { position:absolute; opacity:0; z-index:1; }
  @keyframes pgOn { to{opacity:1} }
  @keyframes pgOff { to{opacity:0} }
  @keyframes pgMid { 0%{opacity:0} 0.01%,99.99%{opacity:1} 100%{opacity:0} }

  .stack { left:40px; right:40px; top:790px; z-index:2; font-family:'Jost'; font-style:italic; font-weight:900; text-align:left; }
  .ln { display:block; line-height:1; padding-bottom:14px; }
  .w { display:inline-block; vertical-align:bottom; margin-right:14px; opacity:0; animation-fill-mode:forwards; white-space:pre; transform-origin:left center; }
  .bleed { margin-left:-40px; }
  .rc { letter-spacing:-0.015em; padding:6px 15px 9px; background:#FF1F0F; color:#FFFFFF; box-shadow:8px 8px 0 #0A0A0A;
        animation-name:wIn; animation-duration:130ms; animation-timing-function:cubic-bezier(.16,.84,.3,1); }
  .rh { letter-spacing:-0.025em; padding:9px 21px 14px; background:#E9FF00; color:#0A0A0A; box-shadow:11px 11px 0 #0A0A0A;
        animation-name:hIn; animation-duration:210ms; animation-timing-function:cubic-bezier(.34,1.3,.64,1); }
  .rb { letter-spacing:-0.035em; padding:14px 34px 21px; background:#E9FF00; color:#0A0A0A; box-shadow:17px 17px 0 #0A0A0A;
        animation-name:hIn; animation-duration:300ms; animation-timing-function:cubic-bezier(.34,1.3,.64,1); }
  @keyframes wIn { from{opacity:0; transform:translateY(0.24em)} to{opacity:1; transform:none} }
  @keyframes hIn { from{opacity:0; transform:scale(0.8)} to{opacity:1; transform:none} }
</style>
<video class="vid" src="demo.mp4" muted></video>
<div class="cue" id="cue1" style="z-index:11;animation-delay:160ms;animation-duration:880ms;">
  <div class="pg stack" id="b1p1" style="opacity:1;">
      <div class="ln" id="b1p1l1"><span class="w rc" id="b1w1" style="font-size:83px;animation-delay:160ms">I</span><span class="w rc" id="b1w2" style="font-size:83px;animation-delay:280ms">FIRED</span><span class="w rc" id="b1w3" style="font-size:83px;animation-delay:600ms">OUR</span></div>
      <div class="ln" id="b1p1l2"><span class="w rh" id="b1w4" style="font-size:113px;animation-delay:760ms">BIGGEST</span></div>
  </div>
</div>
<div class="cue" id="cue2" style="z-index:12;animation-delay:1040ms;animation-duration:1280ms;">
  <div class="pg stack" id="b2p1" style="opacity:1;">
      <div class="ln" id="b2p1l1"><span class="w rh" id="b2w5" style="font-size:104px;animation-delay:1040ms">CLIENT</span><span class="w rc" id="b2w6" style="font-size:76px;animation-delay:1360ms">TWO</span></div>
      <div class="ln" id="b2p1l2"><span class="w rc" id="b2w7" style="font-size:76px;animation-delay:1600ms">YEARS</span><span class="w rc" id="b2w8" style="font-size:76px;animation-delay:1800ms">AGO</span></div>
  </div>
</div>
