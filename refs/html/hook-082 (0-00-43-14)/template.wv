<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --yellow: #ffde04;
    --maroon: #5a1808;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body { width: 720px; height: 1280px; }
  body {
    position: relative;
    overflow: hidden;
    background: #101010;
    font-family: "Oswald", sans-serif;
    color: var(--yellow);
  }
  .stage {
    position: absolute;
    inset: 0;
    width: 720px;
    height: 1280px;
  }
  #scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(180deg, rgba(8,6,4,.42) 0%, rgba(8,6,4,.06) 26%, rgba(8,6,4,.04) 58%, rgba(8,6,4,.6) 100%);
    pointer-events: none;
  }
  .layer { position: absolute; z-index: 2; }
  .text { position: absolute; z-index: 2; line-height: 1.25; letter-spacing: .02em; white-space: nowrap; }

  #fotha {
    left: 55px; top: 36px; max-width: 160px;
    white-space: normal; overflow-wrap: anywhere;
    font-weight: 600; font-size: 19px; letter-spacing: .12em;
  }
  #presents {
    right: 40px; top: 38px; max-width: 160px; text-align: right;
    white-space: normal; overflow-wrap: anywhere;
    font-weight: 600; font-size: 17px; letter-spacing: .16em;
  }

  #center {
    position: absolute;
    left: 0; right: 0; top: 410px;
    width: 720px;
    display: flex; flex-direction: column;
    align-items: center;
    z-index: 2;
  }
  #center > * { position: relative; z-index: 2; width: 100%; }

  #joint {
    text-align: center; white-space: normal;
    font-weight: 600; font-size: 22px; letter-spacing: .18em;
    margin-bottom: 96px;
  }
  #joint .heart {
    display: inline-block;
    width: 17px; height: 15px;
    margin: 0 2px;
    background-color: #d62828;
    clip-path: polygon(50% 100%, 12% 62%, 2% 40%, 6% 18%, 20% 6%, 36% 8%, 50% 22%, 64% 8%, 80% 6%, 94% 18%, 98% 40%, 88% 62%);
  }

  #title {
    text-align: center; white-space: normal;
    font-weight: 700; font-size: 95px; line-height: .94;
    /* the text engine uses natural leading; margins re-align to Chrome oracle */
    margin-top: -27px;
    margin-bottom: -25px;
    padding-bottom: 16px;
    font-style: italic;
    letter-spacing: -.015em;
    transform: scaleX(.87);
    transform-origin: center;
    text-shadow:
      4px 7px 0 var(--maroon),
      8px 11px 16px rgba(0,0,0,.5);
  }
  #title .ln {
    display: block;
    position: relative;
    z-index: 2;
  }
  #title .ln2 { margin-top: -51px; }

  #subtitle {
    text-align: center; white-space: normal;
    font-weight: 500; font-size: 18px; letter-spacing: .12em;
    margin-top: 8px;
  }

  #embreve {
    text-align: center; white-space: normal;
    font-weight: 700; font-size: 52px; line-height: 1.2; letter-spacing: .04em;
    text-shadow: 2px 3px 8px rgba(0,0,0,.6);
    margin-top: 31px;
  }

  #embreve-sub {
    text-align: center; white-space: normal;
    font-weight: 500; font-size: 21px; line-height: 1.3; letter-spacing: .04em;
    margin-top: 6px;
  }
  #embreve-sub .ln {
    display: block;
    position: relative;
    z-index: 2;
  }
  #embreve-sub .ln2 { margin-top: -4px; }

  #logos {
    position: absolute;
    left: 0; right: 0; top: 1160px;
    display: flex; flex-direction: row;
    align-items: center; justify-content: center;
    gap: 22px;
    z-index: 2;
  }
  #jbo {
    position: relative;
    white-space: normal; overflow-wrap: anywhere;
    font-weight: 700; font-size: 40px; letter-spacing: .02em;
  }
  #prima {
    position: relative;
    white-space: normal; overflow-wrap: anywhere;
    font-family: "Poppins", sans-serif;
    font-weight: 500; font-size: 27px; letter-spacing: -.01em;
  }

  #clap {
    left: 580px; top: 175px;
    width: 140px;
    white-space: normal;
    text-align: left;
    color: #e8e0c8;
    font-weight: 500; font-size: 13px; line-height: 1.9; letter-spacing: .04em;
    text-shadow: 0 1px 3px rgba(0,0,0,.8);
    opacity: .92;
  }
  #clap b { font-weight: 600; }
  #clap .cl { display: block; }

  @keyframes inL {
    0%   { opacity: 0; transform: translateX(-90px); }
    100% { opacity: 1; transform: translateX(0); }
  }
  @keyframes inR {
    0%   { opacity: 0; transform: translateX(90px); }
    100% { opacity: 1; transform: translateX(0); }
  }
  @keyframes clapInL {
    0%   { opacity: 0; transform: translateX(-90px); }
    100% { opacity: .92; transform: translateX(0); }
  }

  #fotha            { animation: inL .5s cubic-bezier(.2,.7,.3,1) .10s both; }
  #presents         { animation: inR .5s cubic-bezier(.2,.7,.3,1) .27s both; }
  #clap             { animation: clapInL .5s cubic-bezier(.2,.7,.3,1) .44s both; }
  #joint            { animation: inR .5s cubic-bezier(.2,.7,.3,1) .61s both; }
  #title .ln1       { animation: inL .5s cubic-bezier(.2,.7,.3,1) .78s both; }
  #title .ln2       { animation: inR .5s cubic-bezier(.2,.7,.3,1) .95s both; }
  #subtitle         { animation: inL .5s cubic-bezier(.2,.7,.3,1) 1.12s both; }
  #embreve          { animation: inR .5s cubic-bezier(.2,.7,.3,1) 1.29s both; }
  #embreve-sub .ln1 { animation: inL .5s cubic-bezier(.2,.7,.3,1) 1.46s both; }
  #embreve-sub .ln2 { animation: inR .5s cubic-bezier(.2,.7,.3,1) 1.63s both; }
  #logos            { animation: inL .5s cubic-bezier(.2,.7,.3,1) 1.80s both; }
</style>

<div class="stage">
  <div id="scrim" data-node-id="scrim"></div>

  <div id="fotha" class="text" data-node-id="fotha" data-node-role="text">FOTHA</div>
  <div id="presents" class="text" data-node-id="presents" data-node-role="text">PRESENTS</div>


  <div id="center" data-node-id="center">
    <div id="joint" data-node-id="joint" data-node-role="text">A CLA<span class="heart">&#9829;</span>VER! JOINT</div>
    <div id="title" data-node-id="title" data-node-role="text"><span class="ln ln1">GENTE CRIATIVA</span><span class="ln ln2">VE FILME RUIM</span></div>
    <div id="subtitle" data-node-id="subtitle" data-node-role="text">INSPIRADO NO V&Iacute;DEO DA ALDEIA CRIATIVA</div>
    <div id="embreve" data-node-id="embreve" data-node-role="text">EM BREVE</div>
    <div id="embreve-sub" data-node-id="embreve-sub" data-node-role="text"><span class="ln ln1">TIPO BEM EM BREVE MESMO,</span><span class="ln ln2">PAPO A PROX. SEMANA</span></div>
  </div>

  <div id="logos" data-node-id="logos">
    <div id="jbo" data-node-id="jbo" data-node-role="text">JBO</div>
    <div id="prima" data-node-id="prima" data-node-role="text">prima video</div>
  </div>

  <div id="clap" class="text" data-node-id="clap" data-node-role="text"><span class="cl">PROD ROLL</span><span class="cl">2025</span><span class="cl">DIRECTOR: CLA</span><span class="cl">CAMERA:</span><span class="cl">18/04</span></div>
</div>
