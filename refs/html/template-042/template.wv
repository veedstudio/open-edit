<style>
  * { margin:0; padding:0; box-sizing:border-box; }
  body { width:736px; height:1312px; position:relative; overflow:hidden; }
  .vid { position:absolute; inset:0; width:736px; height:1312px; object-fit:cover; z-index:0; }
  @keyframes cueWin { 0%,99.99%{opacity:1} 100%{opacity:0} }
  .cue { position:absolute; inset:0; opacity:0; animation:cueWin linear forwards; }
  .pg { position:absolute; opacity:0; z-index:1; }
  @keyframes pgOn { to{opacity:1} }
  @keyframes pgOff { to{opacity:0} }
  @keyframes pgMid { 0%{opacity:0} 0.01%,99.99%{opacity:1} 100%{opacity:0} }

  .cap { left:147px; top:981px; width:442px; text-align:center; z-index:2;
         font-family:'Instrument Sans'; font-weight:500; letter-spacing:0.0081em; color:#1A2A2F; text-shadow:0 7px 9px rgba(26,42,47,0.65), 0 0px 11px rgba(251,244,222,0.35), 0 0px 18px rgba(251,244,222,0.25), 0 0px 26px rgba(251,244,222,0.2); }
  .cl { display:block; }
  .u { display:inline-block; white-space:pre; }
  .sp { display:inline-block; white-space:pre; }
  .g { display:inline-block; opacity:0; animation:capG 100ms cubic-bezier(.2,.7,.3,1) forwards; }
  .acc { font-family:'Instrument Serif'; font-style:italic; }
  .cur { display:inline-block; width:3px; height:0.8em; margin:0 -5px 0 2px; background:#4C6274; opacity:0;
         animation-name:capCur; animation-fill-mode:forwards; animation-timing-function:linear; }
  @keyframes capG { from{opacity:0} to{opacity:1} }
  @keyframes capCur { 0%{opacity:0.82} 99.9%{opacity:0.82} 100%{opacity:0} }
</style>
