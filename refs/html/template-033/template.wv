      <div class="cl" id="b5p1l1"><span class="w" id="b5w24" style="animation-delay:6960ms;animation-duration:260ms">An</span><span class="w" id="b5w25" style="animation-delay:7240ms;animation-duration:260ms">emotion</span><span class="w" id="b5w26" style="animation-delay:7640ms;animation-duration:260ms">is</span><span class="w" id="b5w27" style="animation-delay:7760ms;animation-duration:260ms">how</span><span class="w e" id="b5w28" style="animation-delay:7960ms;animation-duration:260ms">the</span></div>
