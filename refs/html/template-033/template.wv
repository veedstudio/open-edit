      <div class="cl" id="b4p1l1"><span class="w" id="b4w18" style="animation-delay:5200ms;animation-duration:260ms">links</span><span class="w" id="b4w19" style="animation-delay:5560ms;animation-duration:260ms">each</span><span class="w e" id="b4w20" style="animation-delay:5760ms;animation-duration:260ms">fact</span></div>
      <div class="cl" id="b4p1l2"><span class="w" id="b4w21" style="animation-delay:6000ms;animation-duration:260ms">to</span><span class="w" id="b4w22" style="animation-delay:6200ms;animation-duration:260ms">an</span><span class="w e i" id="b4w23" style="animation-delay:6360ms;animation-duration:260ms">emotion.</span></div>
