  <div class="pg cap" id="b6p1" style="font-size:61px;opacity:1;">
      <div class="cl" id="b6p1l1"><span class="w" id="b6w32" style="animation-delay:9520ms;animation-duration:260ms">So</span><span class="w" id="b6w33" style="animation-delay:9760ms;animation-duration:260ms">if</span><span class="w" id="b6w34" style="animation-delay:9840ms;animation-duration:260ms">you</span><span class="w i" id="b6w35" style="animation-delay:9960ms;animation-duration:260ms">want</span><span class="w" id="b6w36" style="animation-delay:10120ms;animation-duration:240ms">to</span><span class="w e" id="b6w37" style="animation-delay:10240ms;animation-duration:120ms">be</span></div>
