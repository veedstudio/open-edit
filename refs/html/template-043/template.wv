<meta charset="utf-8">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=EB+Garamond:wght@600&family=Pinyon+Script&display=swap" rel="stylesheet">
<style>
  * { margin:0; padding:0; box-sizing:border-box; }
  body { width:736px; height:1312px; position:relative; overflow:hidden; }
  .vid { position:absolute; inset:0; width:736px; height:1312px; object-fit:cover; z-index:0; }
  @keyframes cueWin { 0%,99.99%{opacity:1} 100%{opacity:0} }
  .cue { position:absolute; inset:0; opacity:0; animation:cueWin linear forwards; }
  .pg { position:absolute; opacity:0; z-index:1; }
  @keyframes pgOn { to{opacity:1} }
  @keyframes pgOff { to{opacity:0} }
  @keyframes pgMid { 0%{opacity:0} 0.01%,99.99%{opacity:1} 100%{opacity:0} }

  .cap { left:81px; right:81px; text-align:center; z-index:2; font-family:'EB Garamond'; font-weight:600; letter-spacing:0.06em;
         line-height:1.3; color:#F7F0E4; text-shadow:0 3px 14px rgba(4,3,2,0.38), 0 2px 3px rgba(4,3,2,0.3); }
  .cl { display:block; }
  .u { display:inline-block; white-space:pre; }
  .sp { display:inline-block; white-space:pre; }
  .g { display:inline-block; opacity:0; animation:capG 120ms cubic-bezier(.2,.7,.3,1) forwards; }
  .cur { display:inline-block; width:3px; height:0.85em; margin-left:3px; vertical-align:text-bottom; background:#FBF684; opacity:0;
         animation-name:capCur; animation-fill-mode:forwards; animation-timing-function:linear; }
  @keyframes capG { from{opacity:0} to{opacity:1} }
  @keyframes capCur { 0%{opacity:1} 99.9%{opacity:1} 100%{opacity:0} }
  .hrow { position:absolute; left:0; width:736px; text-align:center; white-space:nowrap; z-index:3; font-family:'Pinyon Script'; font-weight:400; line-height:1.2;
          color:#FBF684; text-shadow:0 5px 23px rgba(4,3,2,0.38), 0 3px 5px rgba(4,3,2,0.3); }
  .hw { display:inline-block; white-space:pre; opacity:0; transform-origin:50% 60%; animation:heroIn 640ms cubic-bezier(.2,.7,.3,1) both; }
  @keyframes heroIn { 0%{opacity:0; transform:scale(0.94)} 100%{opacity:1; transform:scale(1)} }
</style>
<video class="vid" src="demo.mp4" muted></video>
