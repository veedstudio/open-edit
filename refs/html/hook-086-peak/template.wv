<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body { width: 1276px; height: 720px; background: #000000; }
  #stage {
    position: relative; width: 1276px; height: 720px; overflow: hidden;
    background: #000000;
    font-family: 'Inter', 'Helvetica Neue', Arial, sans-serif;
  }
  .card {
    position: absolute; inset: 19px 20px 20px 21px;
    background: #eef0f4; border-radius: 16px; overflow: hidden;
  }
  /* blue backdrop for cue 1 only; fades to the grey card */
  #blue {
    position: absolute; inset: 0; background: #0540e2;
    animation: blueGate 6.4s linear both;
  }
  @keyframes blueGate {
    0% { opacity: 1; } 19.5% { opacity: 1; } 21% { opacity: 0; } 100% { opacity: 0; }
  }
  .cue {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    display: flex; align-items: center; justify-content: center;
    text-align: center; opacity: 0;
    animation: cueGate 6.4s linear both;
  }
  /* per-word reveal: alpha in + slide up, on inner spans */
  .w { display: inline-block; opacity: 0; animation: wordUp 0.4s cubic-bezier(.2,.7,.3,1) both; }
  @keyframes wordUp {
    0%   { opacity: 0; transform: translateY(34px); }
    100% { opacity: 1; transform: translateY(0); }
  }
  /* cue 2 words: slide up in black, flash blue on arrival, settle to black */
  .wf { display: inline-block; opacity: 0; animation: wordUpFlash 1.1s cubic-bezier(.2,.7,.3,1) both; }
  @keyframes wordUpFlash {
    0%   { opacity: 0; transform: translateY(34px); color: #101010; }
    26%  { color: #101010; }
    30%  { opacity: 1; transform: translateY(0);    color: #0540e2; }
    45%  { color: #0540e2; }
    62%  { color: #101010; }
    100% { opacity: 1; transform: translateY(0);    color: #101010; }
  }

  /* visibility gates: 1% of 6.4s = 64ms */
  #cue1 { animation-name: g1; color: #ffffff; font-weight: 700; font-size: 66px; }
  @keyframes g1 { 0%,2.9% {opacity:0;} 3.2%,19.9% {opacity:1;} 20.4%,100% {opacity:0;} }
  #cue2 { animation-name: g2; color: #101010; font-weight: 700; font-size: 66px; }
  @keyframes g2 { 0%,20.7% {opacity:0;} 21.1%,36.5% {opacity:1;} 37.2%,100% {opacity:0;} }
  #cue3 { animation-name: g3; color: #101010; font-weight: 700; font-size: 236px; letter-spacing: -6px; white-space: nowrap; }
  @keyframes g3 { 0%,37.3% {opacity:0;} 37.8%,51.5% {opacity:1;} 52.3%,100% {opacity:0;} }
  #cue4 { animation-name: g4; color: #101010; font-weight: 700; font-size: 60px; letter-spacing: -0.6px; }
  @keyframes g4 { 0%,52.5% {opacity:0;} 53%,80.5% {opacity:1;} 81.5%,100% {opacity:0;} }
  #cue5 { animation-name: g5; }
  @keyframes g5 { 0%,81.7% {opacity:0;} 82.3%,100% {opacity:1;} }

  .w + .w, .wf + .wf { margin-left: 18px; }

  #badge {
    width: 620px; height: 180px; background: #16161a;
    display: flex; align-items: center; justify-content: center;
    clip-path: polygon(13.2% 0%, 86.8% 0%, 86.8% 23.3%, 100% 50%, 86.8% 76.7%, 86.8% 100%, 13.2% 100%, 13.2% 76.7%, 0% 50%, 13.2% 23.3%);
    color: #f2f2f2; font-weight: 400; font-size: 54px; letter-spacing: 1px;
  }
</style>
</head>
<body>
<div id="stage" data-node-id="stage">
  <div class="card" data-node-id="card" data-node-role="container">
    <div id="blue" aria-hidden="true"></div>

    <div class="cue" id="cue1" data-node-id="cue1" data-node-role="text">
      <span class="w" style="animation-delay:0.22s">Question&nbsp;?</span>
    </div>

    <div class="cue" id="cue2" data-node-id="cue2" data-node-role="text">
      <span class="wf" style="animation-delay:1.38s">Why</span><span class="wf" style="animation-delay:1.56s">does</span>
    </div>

    <div class="cue" id="cue3" data-node-id="cue3" data-node-role="text">
      <span class="w" style="animation-delay:2.44s">NO</span><span class="w" style="animation-delay:2.66s;margin-left:44px">ONE</span>
    </div>

    <div class="cue" id="cue4" data-node-id="cue4" data-node-role="text">
      <span class="w" style="animation-delay:3.42s">Talk</span><span class="w" style="animation-delay:3.58s">about</span><span class="w" style="animation-delay:3.74s">the</span><span class="w" style="animation-delay:3.90s">cost</span><span class="w" style="animation-delay:4.06s">of</span><span class="w" style="animation-delay:4.22s">trying</span><span class="w" style="animation-delay:4.38s">to</span><span class="w" style="animation-delay:4.54s">be</span>
    </div>

    <div class="cue" id="cue5" data-node-id="cue5" data-node-role="container">
      <div id="badge" data-node-role="text"><span class="w" style="animation-delay:5.32s">Exceptional&nbsp;?</span></div>
    </div>
  </div>
</div>
</body>
</html>
