{
  "description": "Open Edit workspace preflight",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "npx --yes @veedstudio/openedit-cli session-start codex",
            "statusMessage": "Checking Open Edit setup"
          }
        ]
      }
    ]
  }
}
